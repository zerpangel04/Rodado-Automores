# Copiar este archivo a ".env" y completar con valores reales.
# Nunca subir el ".env" real a un repositorio.

# Base de datos (Postgres — ej. Supabase, Railway, Neon)
DATABASE_URL="postgresql://usuario:password@host:5432/rodado"

# Auth (a definir la librería en Claude Code — ej. NextAuth, Clerk, Lucia)
AUTH_SECRET=""

# Cotización de dólar (API pública ya probada en el prototipo, no necesita key)
# https://dolarapi.com

# Futuro: WhatsApp Business API
WHATSAPP_API_KEY=""

# Mercado Libre (OAuth por tenant) — developers.mercadolibre.com.ar
# Redirect URI registrado en la app: https://rodado-automores.vercel.app/api/mercadolibre/callback
MERCADOLIBRE_CLIENT_ID=""
MERCADOLIBRE_CLIENT_SECRET=""

# Envío de emails (recuperar contraseña) — https://resend.com
RESEND_API_KEY=""
EMAIL_FROM=""

# Supabase Storage (fotos de vehículos) — bucket público "vehiculos-fotos"
# Service role key: Project Settings > API en supabase.com, nunca la anon key
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
