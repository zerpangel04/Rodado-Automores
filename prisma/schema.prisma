// Rodado — esquema de base de datos inicial
// Basado en el modelo de datos definido en docs/rodado-brief-tecnico.md
// Ejecutar: npx prisma generate / npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  DUENIO
  VENDEDOR
  ADMIN
}

enum EstadoVehiculo {
  DISPONIBLE
  RESERVADO
  VENDIDO
}

enum CanalLead {
  WHATSAPP
  MERCADO_LIBRE
  INSTAGRAM
  WEB
  WEB_IA
}

enum EtapaLead {
  NUEVO
  CONTACTADO
  TEST_DRIVE
  NEGOCIACION
  CERRADO
}

enum EstadoCobro {
  PENDIENTE
  COBRADO
}

enum TipoActividad {
  NUEVO_LEAD
  CAMBIO_ETAPA_LEAD
  VENTA_REGISTRADA
  VEHICULO_VENDIDO
  VEHICULO_RESERVADO
  ML_ACTUALIZADO
  ML_PAUSADA
  ML_ATENCION
  // El vendedor registró un contacto con el lead sin cambiarlo de etapa.
  // Aparece en el Recorrido de la ficha, no en la campanita.
  CONTACTO_LEAD
  // Se liquidaron (o se anuló la liquidación de) comisiones de un vendedor.
  // Van con vendedorId: el vendedor lo ve en su campanita.
  COMISION_LIQUIDADA
  COMISION_ANULADA
}

// Cada concesionaria = un tenant. Todo dato cuelga de un tenant_id.
model Tenant {
  id        String   @id @default(cuid())
  nombre    String
  planId    String   @default("basico")
  plan      Plan     @relation(fields: [planId], references: [id])
  dominio   String?  @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  // El checklist de "Primeros pasos" del Panel general deja de mostrarse
  // para siempre una vez que el dueño toca "Omitir" o una vez que ya se
  // vio la animación de cierre por completar los 3 pasos naturalmente.
  onboardingOmitido Boolean @default(false)

  // Bloque "Sobre nosotros" del catálogo público. Se guarda el año de
  // inicio (no los años) para que "N años en el mercado" no quede viejo.
  sobreNosotros String? @db.VarChar(300)
  anioInicio    Int?
  // Muestra "Ver mapa" y "Cómo llegar" junto a cada local con dirección.
  mostrarMapa   Boolean @default(true)
  // WhatsApp del catálogo (botón flotante y header). Si es null se usa el
  // primer teléfono de sucursal. Se guarda como lo escribió el dueño.
  whatsapp      String? @db.VarChar(30)
  // Color de acento del catálogo (#RRGGBB). Solo se aplica si el plan tiene
  // catalogoPersonalizado; si bajan de plan queda guardado pero no se usa.
  colorAcento   String? @db.VarChar(7)
  // Cotización con la que el catálogo muestra el equivalente ("≈") entre
  // pesos y dólares. Preferencia de cada agencia, en todos los planes.
  cotizacionPreferida TipoCotizacion @default(OFICIAL)
  // Días sin movimiento a partir de los cuales un lead abierto se muestra
  // como "dormido" en Leads y en Pendientes. Lo elige el Dueño o un Admin.
  diasLeadDormido Int @default(7)
  // % de comisión por defecto de la agencia (ej. 3.00). Precarga la comisión
  // en el modal de venta; null = se carga a mano. Usuario.comisionPct lo pisa.
  comisionPct   Decimal? @db.Decimal(5, 2)
  // Días sin movimiento para marcar un expediente de trámites como
  // "trabado" (Ventas → Trámites y Pendientes).
  diasExpedienteTrabado Int @default(10)
  // Foto de portada del catálogo (bucket agencia-portadas). Mismo gating
  // que colorAcento.
  portadaUrl    String?

  usuarios   Usuario[]
  vehiculos  Vehiculo[]
  leads      Lead[]
  ventas     Venta[]
  sucursales Sucursal[]
  liquidacionesComision LiquidacionComision[]
  pasosTramite          PasoTramitePlantilla[]
  expedientes           Expediente[]

  mercadoLibreConexion MercadoLibreConexion?
  actividades          ActividadLog[]

  solicitudesIntegracion SolicitudIntegracion[]
  interesesIntegracion   InteresIntegracion[]

  @@index([planId])
}

// Plan comercial de una agencia. Los límites en null representan "sin
// límite" (plan Empresa). No hardcodeado en código: se lee de acá para
// enforcement de límites (lib/planes.ts) y gating de features.
model Plan {
  id                 String   @id
  nombre             String   @unique
  precioUsd          Decimal
  limiteSucursales   Int?
  limiteVehiculos    Int?
  limiteUsuarios     Int?
  reportesAvanzados  Boolean  @default(false)
  asistenteIA        Boolean  @default(false)
  soportePrioritario Boolean  @default(false)
  // Color de acento y portada del catálogo público.
  catalogoPersonalizado Boolean @default(false)
  // Vehículos destacados en el catálogo público (Básico 0, Prof 3, Empresa 4).
  limiteDestacados   Int      @default(0)
  createdAt          DateTime @default(now())

  tenants Tenant[]
}

// Sucursal física de una agencia. Toda agencia tiene al menos una
// ("Sucursal Principal" por defecto); las agencias con varios locales
// pueden dar de alta más desde /panel/sucursales.
model Sucursal {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  nombre    String
  direccion String?
  telefono  String?
  // Texto libre que se muestra en el catálogo, ej. "Lun a vie 9 a 18 · Sáb 9 a 13".
  horarios  String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  vehiculos Vehiculo[]

  @@index([tenantId])
}

// Conexión OAuth de la agencia con su cuenta de Mercado Libre. Un tenant
// conecta su propia cuenta (no una cuenta global de Rodado).
model MercadoLibreConexion {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  mlUserId     String
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  // Qué se empuja a Mercado Libre cuando se edita un vehículo publicado.
  // "Consultas como leads" no está acá todavía: importar preguntas reales
  // de ML requiere un webhook o polling que no existe hoy — ver README de
  // Integraciones antes de agregar ese switch.
  syncPrecios    Boolean @default(true)
  syncFotos      Boolean @default(true)
  pausarAlVender Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol      @default(VENDEDOR)
  createdAt    DateTime @default(now())
  // % de comisión propio de este vendedor; null = usa el de la agencia.
  comisionPct  Decimal? @db.Decimal(5, 2)

  leadsAsignados          Lead[]                    @relation("VendedorAsignado")
  ventas                  Venta[]                   @relation("VendedorVenta")
  passwordResetTokens     PasswordResetToken[]
  actividadesComoVendedor ActividadLog[]            @relation("VendedorActividad")
  dispositivosConfiables  DispositivoConfiable[]
  codigosVerificacionLogin CodigoVerificacionLogin[]
  liquidacionesRecibidas   LiquidacionComision[]     @relation("LiquidacionVendedor")
  liquidacionesCreadas     LiquidacionComision[]     @relation("LiquidacionCreadaPor")
  liquidacionesAnuladas    LiquidacionComision[]     @relation("LiquidacionAnuladaPor")
  pasosCompletados         PasoExpediente[]          @relation("PasoCompletadoPor")
}

// Token de un solo uso para el flujo de "olvidé mi contraseña".
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
}

// Dispositivo (navegador) que ya verificó un código de un solo uso para
// este usuario — mientras el navegador mande la cookie firmada
// correspondiente (90 días), el login no vuelve a pedir código.
// tokenHash guarda el hash sha256 del valor de la cookie, nunca el valor
// en texto plano.
model DispositivoConfiable {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String
  creadoEn  DateTime @default(now())
  ultimoUso DateTime @default(now())

  @@index([usuarioId, tokenHash])
}

// Código de un solo uso (6 dígitos) para verificar un dispositivo nuevo en
// el login. codigoHash guarda el hash bcrypt del código, nunca el código
// en texto plano — el espacio chico de combinaciones (10^6) se compensa
// limitando a CODIGO_MAX_INTENTOS intentos antes de invalidarlo.
model CodigoVerificacionLogin {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String
  intentos   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([usuarioId])
}

// Login con Google de un email que todavía no tiene cuenta: no alcanza
// el perfil de Google (falta el nombre de la agencia) para crear el
// Tenant, así que se guarda acá temporalmente mientras el usuario
// completa ese dato en /signup/completar-google. Vencido o usado, ya
// no sirve — hay que volver a pasar por el consentimiento de Google.
model GoogleSignupPendiente {
  id        String    @id @default(cuid())
  email     String
  nombre    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Pedido libre de una integración que no está en la lista de
// "En camino" — lo carga el dueño desde /panel/integraciones. Por ahora
// no tiene panel propio para revisarlos, se consultan directo en la DB.
model SolicitudIntegracion {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombrePlataforma String
  comentario       String?
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

// "Avisarme" en una de las integraciones "En camino" (WhatsApp,
// Instagram, etc.) — un tenant solo puede anotarse una vez por tipo
// (@@unique), reflejado en el botón al recargar la página.
model InteresIntegracion {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoIntegracion String
  createdAt       DateTime @default(now())

  @@unique([tenantId, tipoIntegracion])
}

// Rate limiting genérico (login, formulario de contacto público, chat IA).
// Cada intento/request relevante inserta una fila; lib/rateLimit.ts cuenta
// cuántas hay para una "key" dentro de una ventana de tiempo y borra las
// vencidas de paso, así la tabla no crece sin límite sin necesitar un cron.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Vehiculo {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  sucursalId   String
  sucursal     Sucursal       @relation(fields: [sucursalId], references: [id])
  marca        String
  modelo       String
  anio         Int
  km           Int
  // Monto en la moneda indicada (USD o ARS). La columna se sigue llamando
  // "precioUsd" en la base (histórico); en el código es `precio`.
  precio       Decimal        @map("precioUsd")
  moneda       Moneda         @default(USD)
  estado       EstadoVehiculo @default(DISPONIBLE)
  categoria    String?
  transmision  String?
  motor        String?
  fotos        String[]       @default([])
  fechaIngreso DateTime       @default(now())

  // Publicación en Mercado Libre (opcional, uno por vehículo)
  mlItemId    String?
  mlPermalink String?
  // Ej: "active", "payment_required" (creado pero necesita pago del
  // plan de publicación para salir a la luz)
  mlStatus    String?
  mlLastError String? @db.Text

  // Documentación
  docTitulo      Boolean   @default(false)
  docCedula      Boolean   @default(false)
  docDominio     Boolean   @default(false)
  docLibreDeuda  Boolean   @default(false)
  vtvVencimiento DateTime?

  // Destacado en el catálogo público: fecha en que se marcó (null = no
  // destacado). Si el plan baja, se muestran solo los primeros N marcados.
  // Al registrar la venta se limpia.
  destacadoEn DateTime?

  leads       Lead[]
  venta       Venta?
  actividades ActividadLog[]

  @@index([tenantId, estado])
  @@index([sucursalId])
}

model Lead {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  vehiculoId    String?
  vehiculo      Vehiculo? @relation(fields: [vehiculoId], references: [id])
  nombreCliente String
  contacto      String?
  mensaje       String?
  canal         CanalLead
  etapa         EtapaLead @default(NUEVO)
  vendedorId    String?
  vendedor      Usuario?  @relation("VendedorAsignado", fields: [vendedorId], references: [id])
  createdAt     DateTime  @default(now())
  // Último movimiento real del lead: creación, cambio de etapa, reasignación
  // o contacto registrado. Define si está "dormido" (ver lib/leadsDormidos).
  ultimaActividadEn DateTime @default(now())

  actividades ActividadLog[]

  @@index([tenantId, etapa])
  @@index([tenantId, ultimaActividadEn])
}

model Venta {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  vehiculoId       String      @unique
  vehiculo         Vehiculo    @relation(fields: [vehiculoId], references: [id])
  vendedorId       String
  vendedor         Usuario     @relation("VendedorVenta", fields: [vendedorId], references: [id])
  compradorNombre  String?
  precioFinal      Decimal
  comision         Decimal
  // Moneda de precioFinal y de comision (las dos van en la misma). Propia
  // de la venta, no heredada del vehículo: es un registro histórico.
  moneda           Moneda      @default(USD)
  // Pesos por dólar al momento de la venta, con la cotización que tenía
  // elegida la agencia. null en las ventas anteriores a este campo o si la
  // cotización no estaba disponible al registrarla.
  cotizacion       Decimal?
  // DEPRECADO: lo único que lo escribía era "Registrar pago de comisiones",
  // así que en la práctica era "comisión pagada". Se migró a liquidaciones
  // históricas y ya no se usa; queda en la base hasta una migración
  // posterior que lo borre, para poder volver atrás si hiciera falta.
  estadoCobro      EstadoCobro @default(PENDIENTE)
  fecha            DateTime    @default(now())
  // Liquidación en la que se pagó la comisión de esta venta. null =
  // comisión pendiente. Restrict: no se borra una liquidación con ventas.
  liquidacionId    String?
  liquidacion      LiquidacionComision? @relation(fields: [liquidacionId], references: [id], onDelete: Restrict)

  actividades ActividadLog[]
  // Expediente de trámites post-venta (transferencia, etc.). Las ventas
  // nuevas lo crean al registrarse; las viejas, a demanda.
  expediente  Expediente?

  @@index([tenantId, fecha])
  @@index([tenantId, liquidacionId])
}

// Plantilla de pasos del expediente de cada agencia (la edita el Dueño). Se
// crea con la lista por defecto la primera vez que la agencia la usa. Los
// expedientes COPIAN los pasos activos al crearse: cambiar la plantilla no
// toca los expedientes ya abiertos.
model PasoTramitePlantilla {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  nombre    String   @db.VarChar(80)
  orden     Int
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId, orden])
}

// Seguimiento de trámites de una venta. RESTRICT hacia Venta: no se puede
// borrar (revertir) una venta con expediente. La API borra el expediente
// junto con la venta solo si no tiene ningún paso hecho; si tiene alguno,
// bloquea la reversión.
model Expediente {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  ventaId           String    @unique
  venta             Venta     @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  creadoEn          DateTime  @default(now())
  // Último cambio en algún paso: define si está "trabado".
  ultimaActividadEn DateTime  @default(now())
  // Todos los pasos hechos. null = en curso.
  completadoEn      DateTime?

  pasos PasoExpediente[]

  @@index([tenantId, ultimaActividadEn])
}

// Un paso del expediente (copia del nombre y orden de la plantilla).
model PasoExpediente {
  id              String     @id @default(cuid())
  expedienteId    String
  expediente      Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  nombre          String     @db.VarChar(80)
  orden           Int
  hecho           Boolean    @default(false)
  // Fecha del trámite (solo día: ej. el turno en el Registro).
  fecha           DateTime?  @db.Date
  nota            String?    @db.VarChar(300)
  // Quién y cuándo lo marcó como hecho (se guarda solo con la sesión).
  completadoPorId String?
  completadoPor   Usuario?   @relation("PasoCompletadoPor", fields: [completadoPorId], references: [id], onDelete: SetNull)
  completadoEn    DateTime?

  @@index([expedienteId, orden])
}

// Pago de comisiones a un vendedor, en UNA moneda (USD y pesos nunca se
// suman: un vendedor con ventas en las dos tiene dos liquidaciones). Lo
// hace el Dueño o un Admin. Anular vuelve sus ventas a pendiente pero la
// liquidación queda registrada (anuladaEn), con ventaIds como constancia de
// qué ventas incluía.
model LiquidacionComision {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  vendedorId     String
  vendedor       Usuario   @relation("LiquidacionVendedor", fields: [vendedorId], references: [id])
  moneda         Moneda
  // Total y cantidad al momento de liquidar (no se recalculan).
  total          Decimal
  cantidadVentas Int
  ventaIds       String[]
  nota           String?   @db.VarChar(200)
  // Cuándo se liquidó. En las históricas (historica = true) es la fecha de
  // la migración: el botón viejo no guardaba cuándo se pagó.
  fecha          DateTime  @default(now())
  historica      Boolean   @default(false)
  creadaPorId    String?
  creadaPor      Usuario?  @relation("LiquidacionCreadaPor", fields: [creadaPorId], references: [id], onDelete: SetNull)
  anuladaEn      DateTime?
  anuladaPorId   String?
  anuladaPor     Usuario?  @relation("LiquidacionAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: SetNull)

  ventas Venta[]

  @@index([tenantId, fecha])
  @@index([tenantId, vendedorId])
}

// Historial cronológico de eventos de la agencia para el widget "Actividad
// reciente" del Panel general — se genera solo en cada punto donde ya pasa
// algo (nuevo lead, cambio de etapa, venta, vehículo reservado), nunca a
// mano. vendedorId es quien "es dueño" del evento a fines de scoping: un
// VENDEDOR solo ve actividad con su propio vendedorId; queda null en
// eventos que no están atados a una persona (ej. reservar un auto).
model ActividadLog {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  tipo        TipoActividad
  descripcion String
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  vehiculoId  String?
  vehiculo    Vehiculo?     @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)
  ventaId     String?
  venta       Venta?        @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  vendedorId  String?
  vendedor    Usuario?      @relation("VendedorActividad", fields: [vendedorId], references: [id], onDelete: SetNull)
  leido       Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, vendedorId, createdAt])
  @@index([tenantId, leido])
}

enum Moneda {
  USD
  ARS
}

enum TipoCotizacion {
  OFICIAL
  BLUE
}
