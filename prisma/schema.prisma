// Rodado — esquema de base de datos inicial
// Basado en el modelo de datos definido en docs/rodado-brief-tecnico.md
// Ejecutar: npx prisma generate / npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  DUENIO
  VENDEDOR
  ADMIN
}

enum EstadoVehiculo {
  DISPONIBLE
  RESERVADO
  VENDIDO
}

enum CanalLead {
  WHATSAPP
  MERCADO_LIBRE
  INSTAGRAM
  WEB
  WEB_IA
}

enum EtapaLead {
  NUEVO
  CONTACTADO
  TEST_DRIVE
  NEGOCIACION
  CERRADO
}

enum EstadoCobro {
  PENDIENTE
  COBRADO
}

enum TipoActividad {
  NUEVO_LEAD
  CAMBIO_ETAPA_LEAD
  VENTA_REGISTRADA
  VEHICULO_VENDIDO
  VEHICULO_RESERVADO
  ML_ACTUALIZADO
  ML_PAUSADA
  ML_ATENCION
}

// Cada concesionaria = un tenant. Todo dato cuelga de un tenant_id.
model Tenant {
  id        String   @id @default(cuid())
  nombre    String
  plan      String   @default("basico")
  dominio   String?  @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  usuarios   Usuario[]
  vehiculos  Vehiculo[]
  leads      Lead[]
  ventas     Venta[]
  sucursales Sucursal[]

  mercadoLibreConexion MercadoLibreConexion?
  actividades          ActividadLog[]

  solicitudesIntegracion SolicitudIntegracion[]
  interesesIntegracion   InteresIntegracion[]
}

// Sucursal física de una agencia. Toda agencia tiene al menos una
// ("Sucursal Principal" por defecto); las agencias con varios locales
// pueden dar de alta más desde /panel/sucursales.
model Sucursal {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  nombre    String
  direccion String?
  telefono  String?
  createdAt DateTime @default(now())

  vehiculos Vehiculo[]

  @@index([tenantId])
}

// Conexión OAuth de la agencia con su cuenta de Mercado Libre. Un tenant
// conecta su propia cuenta (no una cuenta global de Rodado).
model MercadoLibreConexion {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  mlUserId     String
  accessToken  String
  refreshToken String
  expiresAt    DateTime

  // Qué se empuja a Mercado Libre cuando se edita un vehículo publicado.
  // "Consultas como leads" no está acá todavía: importar preguntas reales
  // de ML requiere un webhook o polling que no existe hoy — ver README de
  // Integraciones antes de agregar ese switch.
  syncPrecios    Boolean @default(true)
  syncFotos      Boolean @default(true)
  pausarAlVender Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol      @default(VENDEDOR)
  createdAt    DateTime @default(now())

  leadsAsignados          Lead[]                    @relation("VendedorAsignado")
  ventas                  Venta[]                   @relation("VendedorVenta")
  passwordResetTokens     PasswordResetToken[]
  actividadesComoVendedor ActividadLog[]            @relation("VendedorActividad")
  dispositivosConfiables  DispositivoConfiable[]
  codigosVerificacionLogin CodigoVerificacionLogin[]
}

// Token de un solo uso para el flujo de "olvidé mi contraseña".
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
}

// Dispositivo (navegador) que ya verificó un código de un solo uso para
// este usuario — mientras el navegador mande la cookie firmada
// correspondiente (90 días), el login no vuelve a pedir código.
// tokenHash guarda el hash sha256 del valor de la cookie, nunca el valor
// en texto plano.
model DispositivoConfiable {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String
  creadoEn  DateTime @default(now())
  ultimoUso DateTime @default(now())

  @@index([usuarioId, tokenHash])
}

// Código de un solo uso (6 dígitos) para verificar un dispositivo nuevo en
// el login. codigoHash guarda el hash bcrypt del código, nunca el código
// en texto plano — el espacio chico de combinaciones (10^6) se compensa
// limitando a CODIGO_MAX_INTENTOS intentos antes de invalidarlo.
model CodigoVerificacionLogin {
  id         String    @id @default(cuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  codigoHash String
  intentos   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([usuarioId])
}

// Login con Google de un email que todavía no tiene cuenta: no alcanza
// el perfil de Google (falta el nombre de la agencia) para crear el
// Tenant, así que se guarda acá temporalmente mientras el usuario
// completa ese dato en /signup/completar-google. Vencido o usado, ya
// no sirve — hay que volver a pasar por el consentimiento de Google.
model GoogleSignupPendiente {
  id        String    @id @default(cuid())
  email     String
  nombre    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Pedido libre de una integración que no está en la lista de
// "En camino" — lo carga el dueño desde /panel/integraciones. Por ahora
// no tiene panel propio para revisarlos, se consultan directo en la DB.
model SolicitudIntegracion {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombrePlataforma String
  comentario       String?
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

// "Avisarme" en una de las integraciones "En camino" (WhatsApp,
// Instagram, etc.) — un tenant solo puede anotarse una vez por tipo
// (@@unique), reflejado en el botón al recargar la página.
model InteresIntegracion {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoIntegracion String
  createdAt       DateTime @default(now())

  @@unique([tenantId, tipoIntegracion])
}

// Rate limiting genérico (login, formulario de contacto público, chat IA).
// Cada intento/request relevante inserta una fila; lib/rateLimit.ts cuenta
// cuántas hay para una "key" dentro de una ventana de tiempo y borra las
// vencidas de paso, así la tabla no crece sin límite sin necesitar un cron.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Vehiculo {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  sucursalId   String
  sucursal     Sucursal       @relation(fields: [sucursalId], references: [id])
  marca        String
  modelo       String
  anio         Int
  km           Int
  precioUsd    Decimal
  estado       EstadoVehiculo @default(DISPONIBLE)
  categoria    String?
  transmision  String?
  motor        String?
  fotos        String[]       @default([])
  fechaIngreso DateTime       @default(now())

  // Publicación en Mercado Libre (opcional, uno por vehículo)
  mlItemId    String?
  mlPermalink String?
  // Ej: "active", "payment_required" (creado pero necesita pago del
  // plan de publicación para salir a la luz)
  mlStatus    String?
  mlLastError String? @db.Text

  // Documentación
  docTitulo      Boolean   @default(false)
  docCedula      Boolean   @default(false)
  docDominio     Boolean   @default(false)
  docLibreDeuda  Boolean   @default(false)
  vtvVencimiento DateTime?

  leads       Lead[]
  venta       Venta?
  actividades ActividadLog[]

  @@index([tenantId, estado])
  @@index([sucursalId])
}

model Lead {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  vehiculoId    String?
  vehiculo      Vehiculo? @relation(fields: [vehiculoId], references: [id])
  nombreCliente String
  contacto      String?
  mensaje       String?
  canal         CanalLead
  etapa         EtapaLead @default(NUEVO)
  vendedorId    String?
  vendedor      Usuario?  @relation("VendedorAsignado", fields: [vendedorId], references: [id])
  createdAt     DateTime  @default(now())

  actividades ActividadLog[]

  @@index([tenantId, etapa])
}

model Venta {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  vehiculoId       String      @unique
  vehiculo         Vehiculo    @relation(fields: [vehiculoId], references: [id])
  vendedorId       String
  vendedor         Usuario     @relation("VendedorVenta", fields: [vendedorId], references: [id])
  compradorNombre  String?
  precioFinal      Decimal
  comision         Decimal
  estadoCobro      EstadoCobro @default(PENDIENTE)
  fecha            DateTime    @default(now())

  actividades ActividadLog[]

  @@index([tenantId, fecha])
}

// Historial cronológico de eventos de la agencia para el widget "Actividad
// reciente" del Panel general — se genera solo en cada punto donde ya pasa
// algo (nuevo lead, cambio de etapa, venta, vehículo reservado), nunca a
// mano. vendedorId es quien "es dueño" del evento a fines de scoping: un
// VENDEDOR solo ve actividad con su propio vendedorId; queda null en
// eventos que no están atados a una persona (ej. reservar un auto).
model ActividadLog {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  tipo        TipoActividad
  descripcion String
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  vehiculoId  String?
  vehiculo    Vehiculo?     @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)
  ventaId     String?
  venta       Venta?        @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  vendedorId  String?
  vendedor    Usuario?      @relation("VendedorActividad", fields: [vendedorId], references: [id], onDelete: SetNull)
  leido       Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, vendedorId, createdAt])
  @@index([tenantId, leido])
}
